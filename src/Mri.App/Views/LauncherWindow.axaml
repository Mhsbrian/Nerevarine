<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mri.App.ViewModels"
        xmlns:omw="using:Mri.Core.OpenMw"
        x:Class="Mri.App.Views.LauncherWindow"
        x:DataType="vm:LauncherViewModel"
        Title="Nerevarine"
        Icon="/Assets/nerevarine.png"
        Width="860" Height="780" MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Georgia, 'Times New Roman', 'Liberation Serif', serif">

  <Window.Styles>
    <Style Selector="Button.tier">
      <Setter Property="Background" Value="#E9DCB4"/>
      <Setter Property="BorderBrush" Value="#8A6D3B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tier:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0E4C0"/>
    </Style>
    <Style Selector="Button.tier.selected">
      <Setter Property="Background" Value="#7A2E1D"/>
      <Setter Property="BorderBrush" Value="#5A2115"/>
    </Style>
    <Style Selector="TextBlock.ink">
      <Setter Property="Foreground" Value="#2E2013"/>
    </Style>
    <Style Selector="Border.codex">
      <Setter Property="Background" Value="#E9DCB4"/>
      <Setter Property="BorderBrush" Value="#B39B62"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>
    <Style Selector="TextBlock.codexTitle">
      <Setter Property="Foreground" Value="#7A2E1D"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="CheckBox.rune">
      <Setter Property="Foreground" Value="#2E2013"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="6,0,0,0"/>
    </Style>
    <Style Selector="CheckBox.rune /template/ Border#NormalRectangle">
      <Setter Property="BorderBrush" Value="#8A6D3B"/>
      <Setter Property="Background" Value="#F0E4C0"/>
      <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="CheckBox.rune:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="#7A2E1D"/>
      <Setter Property="BorderBrush" Value="#5A2115"/>
    </Style>
  </Window.Styles>

  <!-- Parchment ground -->
  <Border>
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#E8D9AC"/>
        <GradientStop Offset="0.5" Color="#E0CF9E"/>
        <GradientStop Offset="1" Color="#D3BF8A"/>
      </LinearGradientBrush>
    </Border.Background>

    <!-- Scroll frame: double rule -->
    <Border Margin="14" BorderBrush="#8A6D3B" BorderThickness="2" CornerRadius="2">
      <Border Margin="4" BorderBrush="#B39B62" BorderThickness="1" Padding="28,20">

        <DockPanel>

          <!-- Masthead -->
          <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Spacing="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
              <Image Source="/Assets/nerevarine.png" Width="52" Height="52" VerticalAlignment="Center"/>
              <TextBlock Classes="ink" Text="N E R E V A R I N E"
                         FontSize="34" FontWeight="Bold" VerticalAlignment="Center"/>
              <Image Source="/Assets/nerevarine.png" Width="52" Height="52" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="— ❖ —" Foreground="#8A6D3B" FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Classes="ink" FontStyle="Italic" FontSize="13" HorizontalAlignment="Center"
                       Text="{Binding ModCount, StringFormat='Vvardenfell, rebuilt from {0} works of the community'}"/>
          </StackPanel>

          <!-- Foot: play + status -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="8">
            <Button Command="{Binding PlayCommand}" IsEnabled="{Binding !Busy}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#7A2E1D" BorderBrush="#5A2115" BorderThickness="2"
                    CornerRadius="3" Padding="0,14">
              <TextBlock Text="BEGIN" Foreground="#F0E4C0" FontSize="22"
                         FontWeight="Bold" LetterSpacing="6"/>
            </Button>
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Classes="ink" FontSize="11" Opacity="0.75"
                         Text="{Binding ListVersion, StringFormat='Canon {0}'}"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14">
                <Button Command="{Binding OpenModsFolderCommand}" Background="Transparent"
                        BorderThickness="0" Padding="0">
                  <TextBlock Classes="ink" Text="Open mods folder" FontSize="11"
                             TextDecorations="Underline" Opacity="0.75"/>
                </Button>
                <Button Command="{Binding ReinstallCommand}" Background="Transparent"
                        BorderThickness="0" Padding="0">
                  <TextBlock Classes="ink" Text="Verify / reinstall" FontSize="11"
                             TextDecorations="Underline" Opacity="0.75"/>
                </Button>
              </StackPanel>
              <TextBlock Classes="ink" FontStyle="Italic" FontSize="12"
                         HorizontalAlignment="Center" Text="{Binding StatusLine}"/>
            </DockPanel>
          </StackPanel>

          <!-- Body -->
          <Grid Margin="0,20,0,14" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <Border IsVisible="{Binding UpdateAvailable}" Background="#EFE3BC"
                    BorderBrush="#7A2E1D" BorderThickness="1" CornerRadius="3" Padding="14,10">
              <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding ApplyUpdateCommand}"
                        IsEnabled="{Binding !Busy}" Background="#7A2E1D" BorderThickness="0"
                        CornerRadius="3" Padding="14,7" VerticalAlignment="Center">
                  <TextBlock Text="Apply the update" Foreground="#F0E4C0" FontSize="12" FontWeight="Bold"/>
                </Button>
                <TextBlock Classes="ink" Text="{Binding UpdateBanner}" FontSize="12"
                           FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
              </DockPanel>
            </Border>

            <TextBlock Grid.Row="1" Margin="0,0,0,10" Classes="ink" Text="The Manner of its Telling"
                       FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>

            <Grid Grid.Row="2" Margin="0,0,0,12" ColumnDefinitions="*,12,*,12,*">
              <Button Grid.Column="0" Classes="tier"
                      Classes.selected="{Binding Tier, Converter={x:Static vm:Converters.IsTier}, ConverterParameter={x:Static omw:QualityTier.Apprentice}}"
                      Command="{Binding SelectTierCommand}"
                      CommandParameter="{x:Static omw:QualityTier.Apprentice}">
                <StackPanel Spacing="4">
                  <TextBlock Text="APPRENTICE" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"
                             Foreground="{Binding Tier, Converter={x:Static vm:Converters.TierInk}, ConverterParameter={x:Static omw:QualityTier.Apprentice}}"/>
                  <TextBlock Text="Runs fast on older PCs: no shadows, short view range, simple water."
                             FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85"
                             Foreground="{Binding Tier, Converter={x:Static vm:Converters.TierInk}, ConverterParameter={x:Static omw:QualityTier.Apprentice}}"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Classes="tier"
                      Classes.selected="{Binding Tier, Converter={x:Static vm:Converters.IsTier}, ConverterParameter={x:Static omw:QualityTier.Adept}}"
                      Command="{Binding SelectTierCommand}"
                      CommandParameter="{x:Static omw:QualityTier.Adept}">
                <StackPanel Spacing="4">
                  <TextBlock Text="ADEPT" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"
                             Foreground="{Binding Tier, Converter={x:Static vm:Converters.TierInk}, ConverterParameter={x:Static omw:QualityTier.Adept}}"/>
                  <TextBlock Text="Balanced for typical PCs: long views, standard shadows, all effects."
                             FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85"
                             Foreground="{Binding Tier, Converter={x:Static vm:Converters.TierInk}, ConverterParameter={x:Static omw:QualityTier.Adept}}"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="4" Classes="tier"
                      Classes.selected="{Binding Tier, Converter={x:Static vm:Converters.IsTier}, ConverterParameter={x:Static omw:QualityTier.Master}}"
                      Command="{Binding SelectTierCommand}"
                      CommandParameter="{x:Static omw:QualityTier.Master}">
                <StackPanel Spacing="4">
                  <TextBlock Text="MASTER" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"
                             Foreground="{Binding Tier, Converter={x:Static vm:Converters.TierInk}, ConverterParameter={x:Static omw:QualityTier.Master}}"/>
                  <TextBlock Text="Everything at maximum for strong PCs: farthest views, full shadows, dense grass."
                             FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85"
                             Foreground="{Binding Tier, Converter={x:Static vm:Converters.TierInk}, ConverterParameter={x:Static omw:QualityTier.Master}}"/>
                </StackPanel>
              </Button>
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,0,0,12" Spacing="6">
              <TextBlock Classes="ink" FontSize="11" FontStyle="Italic" Opacity="0.7" HorizontalAlignment="Center"
                         Text="Your choice rewrites the game's video settings each time you press BEGIN — nothing else is touched."/>
              <Button Command="{Binding AutoDetectCommand}" HorizontalAlignment="Center"
                      Background="Transparent" BorderBrush="#8A6D3B" BorderThickness="1"
                      CornerRadius="3" Padding="16,6">
                <TextBlock Classes="ink" Text="✦  Let the launcher pick for this machine" FontSize="12"/>
              </Button>
            </StackPanel>

            <Grid Grid.Row="4" ColumnDefinitions="*,14,*" MinHeight="120">

              <Border Grid.Column="0" Classes="codex">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
                    <TextBlock Classes="codexTitle" Text="MECHANISMS OF THE MODS"/>
                    <Rectangle Height="1" Fill="#B39B62"/>
                  </StackPanel>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding EngineFlags}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EngineFlagRow">
                          <DockPanel Margin="0,4">
                            <CheckBox Classes="rune" DockPanel.Dock="Left"
                                      IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Top"/>
                            <StackPanel Margin="4,0,0,0">
                              <TextBlock Classes="ink" Text="{Binding Label}" FontSize="12"/>
                              <TextBlock Text="{Binding RequiredBy}" FontSize="10" FontStyle="Italic"
                                         Foreground="#6B573B" TextWrapping="Wrap"/>
                            </StackPanel>
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>

              <Border Grid.Column="2" Classes="codex">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
                    <TextBlock Classes="codexTitle" Text="{Binding Tier, Converter={x:Static vm:Converters.TierLedgerTitle}}"/>
                    <Rectangle Height="1" Fill="#B39B62"/>
                  </StackPanel>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ActiveSettings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QualitySettingRow">
                          <Border BorderBrush="#D9C99B" BorderThickness="0,0,0,1" Padding="0,3">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Left" Classes="ink" Text="{Binding Name}"
                                         FontSize="11" FontWeight="Bold" Width="150"/>
                              <TextBlock Text="{Binding Value}" FontSize="11" Foreground="#6B573B"
                                         TextWrapping="Wrap"/>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>

            </Grid>

          </Grid>
        </DockPanel>
      </Border>
    </Border>
  </Border>
</Window>
