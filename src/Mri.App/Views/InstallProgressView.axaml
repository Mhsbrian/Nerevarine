<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mri.App.ViewModels"
             x:Class="Mri.App.Views.InstallProgressView"
             x:DataType="vm:InstallProgressViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Headline}" FontSize="22" FontWeight="Bold"
               Margin="0,0,0,14" TextWrapping="Wrap"/>

    <!-- Failure / retry panel -->
    <Border DockPanel.Dock="Bottom" Background="#332525" CornerRadius="6" Padding="14,10" Margin="0,10,0,0"
            IsVisible="{Binding FailureMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding FailureMessage}" TextWrapping="Wrap" FontSize="13"/>
        <Border Background="#241b1b" CornerRadius="4" Padding="4"
                IsVisible="{Binding HasFailedMods}">
          <ScrollViewer MaxHeight="150">
            <ItemsControl ItemsSource="{Binding FailedMods}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FailedModRow">
                  <Grid ColumnDefinitions="Auto,*" Margin="2,3">
                    <CheckBox Grid.Column="0" IsChecked="{Binding Skip}" Padding="0"
                              VerticalAlignment="Top" MinWidth="0" Margin="4,0,8,0"
                              ToolTip.Tip="Tick to leave this mod out and continue without it"/>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#e0a5a5"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="#96788a"
                                 TextWrapping="Wrap" IsVisible="{Binding HasReason}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Retry missing downloads" Command="{Binding RetryCommand}"/>
          <Button Content="{Binding SkipButtonLabel}" Command="{Binding SkipTickedAndContinueCommand}"
                  IsVisible="{Binding HasFailedMods}"/>
          <Button Content="Tick all" Command="{Binding TickAllCommand}" FontSize="12"
                  IsVisible="{Binding HasFailedMods}"/>
          <Button Content="Save diagnostics zip" Command="{Binding SaveDiagnosticsCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding LogFilePath, StringFormat='Full log: {0}'}" FontSize="11"
                   Foreground="#8b90a0" TextWrapping="Wrap"
                   IsVisible="{Binding LogFilePath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        <TextBlock Text="{Binding DiagnosticsMessage}" FontSize="12" Foreground="#9ed49e"
                   TextWrapping="Wrap"
                   IsVisible="{Binding DiagnosticsMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </StackPanel>
    </Border>

    <!-- Log tail -->
    <Border DockPanel.Dock="Bottom" Background="#15171c" CornerRadius="6" Padding="8" Height="130"
            Margin="0,10,0,0">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding LogLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" FontFamily="monospace" FontSize="11" Foreground="#7d8494"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="Pause" Command="{Binding CancelCommand}"/>
    </StackPanel>

    <!-- Step checklist -->
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Steps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StepViewModel">
            <Border Padding="4,7">
              <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StatusIcon}" FontSize="14"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Label}" FontSize="14"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" FontSize="12"
                           Foreground="#8b90a0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxLines="1" IsVisible="{Binding IsActive}"/>
                <ProgressBar Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" Height="4"
                             Minimum="0" Maximum="1" Value="{Binding Fraction}"
                             IsVisible="{Binding HasFraction}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
