<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mri.App.ViewModels"
             x:Class="Mri.App.Views.DoneView"
             x:DataType="vm:DoneViewModel">
  <StackPanel Spacing="18" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Center">
    <TextBlock Text="✓ All done" FontSize="30" FontWeight="Bold" Foreground="#9ed49e"/>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" Foreground="#c9ccd4"/>
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="Launch OpenMW" Classes="accent" Command="{Binding LaunchOpenMwCommand}"
              IsEnabled="{Binding CanLaunch}"/>
      <Button Content="Open install folder" Command="{Binding OpenInstallFolderCommand}"/>
      <Button Content="Save diagnostics zip" Command="{Binding SaveDiagnosticsCommand}"/>
    </StackPanel>
    <TextBlock Text="{Binding EntryPointMessage}" FontSize="12" Foreground="#d9c58c" TextWrapping="Wrap"
               IsVisible="{Binding EntryPointMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    <TextBlock Text="{Binding DiagnosticsMessage}" FontSize="12" Foreground="#9ed49e" TextWrapping="Wrap"
               IsVisible="{Binding DiagnosticsMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </StackPanel>
</UserControl>
