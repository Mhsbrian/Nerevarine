<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mri.App.ViewModels"
             xmlns:views="using:Mri.App.Views"
             x:Class="Mri.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <DataTemplate DataType="vm:WelcomeViewModel">
      <views:WelcomeView/>
    </DataTemplate>
    <DataTemplate DataType="vm:GameDetectViewModel">
      <views:GameDetectView/>
    </DataTemplate>
    <DataTemplate DataType="vm:InstallDirViewModel">
      <views:InstallDirView/>
    </DataTemplate>
    <DataTemplate DataType="vm:NexusAuthViewModel">
      <views:NexusAuthView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ReviewViewModel">
      <views:ReviewView/>
    </DataTemplate>
    <DataTemplate DataType="vm:InstallProgressViewModel">
      <views:InstallProgressView/>
    </DataTemplate>
    <DataTemplate DataType="vm:DoneViewModel">
      <views:DoneView/>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
